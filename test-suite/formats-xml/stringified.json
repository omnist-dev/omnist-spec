{
  "vectors": [
    {
      "name": "formats-xml/stringified/integer-leaf-reports-value-stringified",
      "spec": "docs/08-conformance-and-errors.md#838-format-codec-adjustments",
      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "xml",
        "document": {
          "edges": [
            [
              "r",
              {
                "edges": [
                  [
                    "n",
                    {
                      "scalar": {
                        "kind": "integer",
                        "value": 5
                      }
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "<r><n>5</n></r>",
        "diagnostics": [
          {
            "path": "$.r.n",
            "code": "format.value-stringified"
          }
        ]
      },
      "comment": "XML has no typed literals, so an integer is written as its text, `<n>5</n>`, and reads back as the string \"5\". That is an adjustment (E-6 explains why it succeeds, unlike a null), and 8.3.8 gives it `format.value-stringified` at the Document path of the leaf."
    },
