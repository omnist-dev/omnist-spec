    {
      "name": "formats-xml/stringified/date-leaf-reports-temporal-stringified",
      "spec": "docs/08-conformance-and-errors.md#838-format-codec-adjustments",
      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "xml",
        "document": {
          "edges": [
            [
              "r",
              {
                "edges": [
                  [
                    "d",
                    {
                      "scalar": {
                        "kind": "date",
                        "value": "2024-01-15"
                      }
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "<r><d>2024-01-15</d></r>",
        "diagnostics": [
          {
            "path": "$.r.d",
            "code": "format.temporal-stringified"
          }
        ]
      },
      "comment": "E-5: a date leaf is written as its ISO-8601 text and reported as format.temporal-stringified at the Document path of the leaf. It is not also reported as format.value-stringified: a leaf takes one of the two codes."
    },
