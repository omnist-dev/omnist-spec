    {
      "name": "formats-xml/stringified/repeated-leaves-are-reported-per-edge-with-an-index",
      "spec": "docs/08-conformance-and-errors.md#838-format-codec-adjustments",
      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "xml",
        "document": {
          "edges": [
            [
              "r",
              {
                "edges": [
                  [
                    "n",
                    {
                      "scalar": {
                        "kind": "integer",
                        "value": 1
                      }
                    }
                  ],
                  [
                    "n",
                    {
                      "scalar": {
                        "kind": "integer",
                        "value": 2
                      }
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "<r><n>1</n><n>2</n></r>",
        "diagnostics": [
          {
            "path": "$.r.n[0]",
            "code": "format.value-stringified"
          },
          {
            "path": "$.r.n[1]",
            "code": "format.value-stringified"
          }
        ]
      },
      "comment": "E-10 on a write diagnostic: a label that occurs twice in its node is indexed on every edge, the first included, so the two reports are `$.r.n[0]` and `$.r.n[1]`, and one report per stringified leaf."
    },
    {
