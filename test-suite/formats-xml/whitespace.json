{
  "vectors": [
    {
      "name": "formats-xml/whitespace/spaces-only-element-reads-as-the-spaces",
      "spec": "docs/08-conformance-and-errors.md#853-operation-drivers",
      "operation": "parse",
      "purpose": "edge-case",
      "input": {
        "format": "xml",
        "text": "<r><a>  </a></r>"
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "r",
              {
                "edges": [
                  [
                    "a",
                    {
                      "scalar": {
                        "kind": "string",
                        "value": "  "
                      }
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "comment": "E-18: an element with no child elements keeps its text as written. `<a>  </a>` is the two-space string, not the empty string. This is the case a write vector cannot pin, because the harness comparison strips whitespace between `>` and `<`."
    },
    {
