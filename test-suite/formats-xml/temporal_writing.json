    {
      "name": "formats-xml/temporal-writing/time-with-seconds",
      "spec": "docs/08-conformance-and-errors.md#838-format-codec-adjustments",
      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "xml",
        "document": {
          "edges": [
            [
              "r",
              {
                "edges": [
                  [
                    "a",
                    {
                      "scalar": {
                        "kind": "time",
                        "value": "12:00:00"
                      }
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "<r><a>12:00:00</a></r>",
        "diagnostics": [
          {
            "path": "$.r.a",
            "code": "format.temporal-stringified"
          }
        ]
      },
      "comment": "E-37 and E-5: XML has no temporal literal; the leaf is written as its ISO-8601 text, unaltered, with its seconds, and reported."
    },
