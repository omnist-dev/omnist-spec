  "vectors": [
    {
      "name": "formats-json/temporal-writing/time-with-seconds",
      "spec": "docs/08-conformance-and-errors.md#838-format-codec-adjustments",
      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "json",
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "time",
                  "value": "12:00:00"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "{\"a\": \"12:00:00\"}",
        "diagnostics": [
          {
            "path": "$.a",
            "code": "format.temporal-stringified"
          }
        ]
      },
      "comment": "E-37: JSON has no temporal literal, so the value is written as its ISO-8601 text, unaltered, with its seconds, and reported."
    },
