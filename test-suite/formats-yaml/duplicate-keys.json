          {
            "path": "line:col",
            "code": "parse.codec-syntax"
          }
        ]
      },
      "comment": "C-12: the shape of the values is irrelevant; a scalar followed by a sequence under one key is a repeat."
    },
    {
      "name": "formats-yaml/duplicate-keys/the-same-key-in-two-different-mappings-is-accepted",
      "spec": "docs/07-codecs-and-deserialization.md#71-two-stages",
      "operation": "parse",
      "purpose": "happy-path",
      "input": {
        "format": "yaml",
