      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "x",
              {
                "edges": [
                  [
                    "a",
                    {
                      "scalar": {
                        "kind": "integer",
                        "value": 1
                      }
                    }
                  ]
                ]
              }
            ],
            [
              "y",
              {
                "edges": [
                  [
                    "a",
                    {
                      "scalar": {
                        "kind": "integer",
                        "value": 2
                      }
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "comment": "Control for C-12: a key repeated across two different mappings is not a repeat."
    },
    {
      "name": "formats-yaml/duplicate-keys/keys-differing-only-in-case-are-different-keys",
      "spec": "docs/07-codecs-and-deserialization.md#71-two-stages",
      "operation": "parse",
      "purpose": "happy-path",
      "input": {
        "format": "yaml",
        "text": "a: 1\nA: 2\n"
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "integer",
                  "value": 1
                }
              }
            ],
            [
              "A",
              {
                "scalar": {
                  "kind": "integer",
                  "value": 2
                }
              }
            ]
          ]
        }
      },
      "comment": "Control for C-12: keys compare byte for byte (D-16), so `a` and `A` are two keys."
    }
