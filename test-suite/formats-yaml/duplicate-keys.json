    {
      "name": "formats-yaml/duplicate-keys/repeated-top-level-key-is-a-codec-syntax-error",
      "spec": "docs/07-codecs-and-deserialization.md#71-two-stages",
      "operation": "parse",
      "purpose": "error-case",
      "input": {
        "format": "yaml",
        "text": "a: 1\nb: 2\na: 3\n"
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "line:col",
            "code": "parse.codec-syntax"
          }
        ]
      },
      "comment": "C-12: a YAML mapping that repeats a key is rejected, not read as `a = 3, b = 2` or any other Document. The path is a text position, so it is the E-32 placeholder."
    },
