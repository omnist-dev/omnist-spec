    {
      "name": "formats-yaml/duplicate-keys/quoted-and-plain-spellings-are-the-same-key",
      "spec": "docs/07-codecs-and-deserialization.md#71-two-stages",
      "operation": "parse",
      "purpose": "error-case",
      "input": {
