    {
      "name": "formats-yaml/number-spellings/octal-with-0o-prefix-is-a-string",
      "spec": "docs/07-codecs-and-deserialization.md#71-two-stages",
      "operation": "parse",
      "purpose": "edge-case",
      "input": {
        "format": "yaml",
        "text": "a: 0o17\n"
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "string",
                  "value": "0o17"
                }
              }
            ]
          ]
        }
      },
      "comment": "C-17: `0o17` is YAML 1.2's octal; YAML 1.1's core schema does not resolve it, so it is a string."
    },
