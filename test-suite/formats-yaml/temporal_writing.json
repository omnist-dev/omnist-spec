      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "yaml",
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "datetime",
                  "value": "2024-01-15T12:00:00+01:00"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "a: 2024-01-15T12:00:00+01:00\n"
      },
      "comment": "E-37: YAML resolves this to a date or timestamp, so it is written as a plain ISO-8601 scalar with its seconds, the `T` separator and the offset as held; nothing is reported."
    },
