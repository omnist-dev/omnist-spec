{
  "vectors": [
    {
      "name": "formats-yaml/temporal-writing/time-with-seconds",
      "spec": "docs/08-conformance-and-errors.md#838-format-codec-adjustments",
      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "yaml",
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "time",
                  "value": "12:00:00"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "a: \"12:00:00\"\n",
        "diagnostics": [
          {
            "path": "$.a",
            "code": "format.temporal-stringified"
          }
        ]
      },
      "comment": "E-37: YAML has no time-of-day type; unquoted, this text would resolve to an integer or a float. It is written as a double-quoted ISO-8601 string with its seconds and reported."
    },
