    {
      "name": "validate/label-quoting/dotted-label-is-bracket-quoted",
      "spec": "docs/08-conformance-and-errors.md#84-paths",
      "operation": "validate",
      "purpose": "error-case",
      "input": {
        "schema": "record R {\n    \"x\" [0,1]: string,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "x",
              {
                "scalar": {
                  "kind": "string",
                  "value": "ok"
                }
              }
            ],
            [
              "a.b",
              {
                "scalar": {
                  "kind": "string",
                  "value": "v"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$[\"a.b\"]",
            "code": "validate.unexpected-field"
          }
        ]
      },
      "comment": "E-36: a label holding a dot is quoted, so it cannot be mistaken for `b` inside `a`."
    },
