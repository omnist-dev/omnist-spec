    {
      "name": "validate/scalar-kinds/date-does-not-satisfy-datetime",
      "spec": "docs/06-schema-algebra.md#63-scalar-subtyping",
      "operation": "validate",
      "purpose": "edge-case",
      "input": {
        "schema": "record R {\n    \"n\": datetime,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "date",
                  "value": "2024-01-01"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$.n",
            "code": "validate.type-mismatch"
          }
        ]
      },
      "comment": "date is not a subtype of datetime -- the only subtyping relation in the model is integer/number (Sec6.3). Materializing this input would succeed (the date-to-datetime upgrade in ch.7's table); validating it does not."
    },
    {
