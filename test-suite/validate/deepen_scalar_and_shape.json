{
  "vectors": [
    {
      "name": "validate/scalar-kinds/integer-satisfies-number-typed-field",
      "spec": "docs/06-schema-algebra.md#63-scalar-subtyping",
      "operation": "validate",
      "purpose": "edge-case",
      "input": {
        "schema": "record R {\n    \"n\": number,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "integer",
                  "value": 3
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true
      },
      "comment": "The one sanctioned scalar subtyping relation applies at the value level too, not just between schemas: an integer value satisfies a number-typed field directly, with no materialize step needed."
    },
    {
      "name": "validate/scalar-kinds/number-does-not-satisfy-integer-even-when-whole",
      "spec": "docs/06-schema-algebra.md#63-scalar-subtyping",
      "operation": "validate",
      "purpose": "edge-case",
      "input": {
        "schema": "record R {\n    \"n\": integer,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "number",
                  "value": 3.0
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$.n",
            "code": "validate.type-mismatch"
          }
        ]
      },
      "comment": "The subtyping relation is one-directional. A number value of 3.0 is numerically whole but validate checks kind, never value -- and never converts. Materializing this same input against this schema would succeed (Sec7.2's value-exact upgrade table); validating it does not."
    },
