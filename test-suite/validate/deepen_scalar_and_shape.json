    {
      "name": "validate/cardinality/above-maximum",
      "spec": "docs/03-schema-model.md#34-cardinality",
      "operation": "validate",
      "purpose": "error-case",
      "input": {
        "schema": "record R {\n    \"tag\" [,2]: string,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "a"
                }
              }
            ],
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "b"
                }
              }
            ],
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "c"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$",
            "code": "validate.cardinality"
          }
        ]
      },
      "comment": "Three `tag` edges against a declared maximum of 2. Like the below-minimum vector already in this suite, the path is the containing node, not the edges themselves."
    },
    {
      "name": "validate/cardinality/exact-count-required-mismatch",
      "spec": "docs/03-schema-model.md#34-cardinality",
      "operation": "validate",
      "purpose": "error-case",
      "input": {
        "schema": "record R {\n    \"tag\" [3]: string,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "a"
                }
              }
            ],
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "b"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$",
            "code": "validate.cardinality"
          }
        ]
      },
      "comment": "[3] means exactly 3 (min=max=3, the OSD shorthand for a fixed count); two edges is neither too few by min alone nor too many by max alone in isolation, but is wrong against the exact requirement."
    },
    {
      "name": "validate/cardinality/within-bounds-array",
      "spec": "docs/03-schema-model.md#34-cardinality",
      "operation": "validate",
      "purpose": "happy-path",
      "input": {
        "schema": "record R {\n    \"tag\" [,2]: string,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "a"
                }
              }
            ],
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "b"
                }
              }
            ]
