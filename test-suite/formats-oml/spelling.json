{
  "vectors": [
    {
      "name": "formats-oml/spelling/negative-zero-keeps-its-sign",
      "spec": "docs/04-oml-grammar.md#49-canonical-output",
      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "oml",
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "number",
                  "value": -0.0
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "a: -0.0"
      },
      "comment": "OML-30: a negative zero is written -0.0. Writing 0.0 changes the value (D-5, 2.2.1)."
    },
    {
      "name": "formats-oml/spelling/positive-zero",
      "spec": "docs/04-oml-grammar.md#49-canonical-output",
      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "oml",
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "number",
                  "value": 0.0
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "a: 0.0"
      },
      "comment": "OML-30: positive zero stays 0.0, distinct from the vector above."
    },
