                      }
                    }
                  ],
                  [
                    "pc",
                    {
                      "scalar": {
                        "kind": "string",
                        "value": "8001"
                      }
                    }
                  ]
                ]
              }
            ],
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "x"
                }
              }
            ],
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "y"
                }
              }
            ]
