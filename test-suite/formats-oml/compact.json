{
  "vectors": [
    {
      "name": "formats-oml/compact/whole-document-on-one-line-edges-separated-by-semicolons",
      "spec": "docs/04-oml-grammar.md#49-canonical-output",
      "operation": "write",
      "purpose": "edge-case",
      "input": {
        "format": "oml",
        "document": {
          "edges": [
            [
              "name",
              {
                "scalar": {
                  "kind": "string",
                  "value": "Ann"
                }
              }
            ],
            [
              "adr",
              {
                "edges": [
                  [
                    "city",
                    {
                      "scalar": {
                        "kind": "string",
                        "value": "Z"
                      }
                    }
                  ],
                  [
                    "pc",
                    {
                      "scalar": {
                        "kind": "string",
                        "value": "8001"
                      }
                    }
                  ]
                ]
              }
            ],
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "x"
                }
              }
            ],
            [
              "tag",
              {
                "scalar": {
                  "kind": "string",
                  "value": "y"
                }
              }
            ]
          ]
        },
        "compact": true
      },
      "expect": {
        "ok": true,
        "text": "name: \"Ann\"; adr: { city: \"Z\"; pc: \"8001\" }; tag: \"x\"; tag: \"y\""
      },
      "comment": "OML-22: compact mode writes the whole Document on one line with edges separated by `;`; this is the section's own worked example. The Document is the one the expanded example denotes."
    },
