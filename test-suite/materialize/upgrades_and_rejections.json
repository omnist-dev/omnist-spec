    {
      "name": "materialize/upgrades/whole-number-to-integer-is-value-exact",
      "spec": "docs/07-codecs-and-deserialization.md#72-materialization-rules",
      "operation": "materialize",
      "purpose": "edge-case",
      "input": {
        "schema": "record R {\n    \"n\": integer,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "number",
                  "value": 1.0
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "integer",
                  "value": 1
                }
              }
            ]
          ]
        }
      },
      "comment": "1.0 upgrades to integer because the conversion is value-exact -- it loses nothing. This is the one direction materialize permits between integer and number leaves."
    },
    {
      "name": "materialize/upgrades/integer-to-number-always-yields-a-float-representation",
      "spec": "docs/07-codecs-and-deserialization.md#72-materialization-rules",
      "operation": "materialize",
      "purpose": "edge-case",
      "input": {
        "schema": "record R {\n    \"n\": number,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "integer",
                  "value": 1
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "number",
                  "value": 1.0
                }
              }
            ]
          ]
        }
      },
      "comment": "A number-typed field always materializes to a host float, never a host integer, regardless of whether the source value looked whole -- the reverse direction of the row above, easy to miss since a table showing 'Yes' doesn't state the target representation explicitly."
    },
    {
      "name": "materialize/rejections/quoted-numeral-string-does-not-upgrade-to-integer",
      "spec": "docs/07-codecs-and-deserialization.md#72-materialization-rules",
      "operation": "materialize",
      "purpose": "error-case",
      "input": {
        "schema": "record R {\n    \"n\": integer,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "string",
                  "value": "1"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$.n",
            "code": "materialize.inexact-conversion"
          }
        ]
      },
      "comment": "A string is not a number -- coercion here would invent a numeric interpretation that doesn't already exist in the value, which the value-exact rule forbids."
    },
    {
      "name": "materialize/rejections/non-whole-number-does-not-upgrade-to-integer",
      "spec": "docs/07-codecs-and-deserialization.md#72-materialization-rules",
      "operation": "materialize",
      "purpose": "error-case",
      "input": {
        "schema": "record R {\n    \"n\": integer,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "number",
                  "value": 1.5
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$.n",
            "code": "materialize.inexact-conversion"
          }
        ]
      },
      "comment": "1.5 truncating to 1 would lose information, so materialize refuses rather than silently rounding."
    },
