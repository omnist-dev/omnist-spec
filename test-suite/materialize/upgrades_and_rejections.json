    {
      "name": "materialize/collect-all/every-inexact-conversion-is-reported-not-just-the-first",
      "spec": "docs/07-codecs-and-deserialization.md#72-materialization-rules",
      "operation": "materialize",
      "purpose": "edge-case",
      "input": {
        "schema": "record R {\n    \"a\": integer,\n    \"b\": boolean,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "string",
                  "value": "x"
                }
              }
            ],
            [
              "b",
              {
                "scalar": {
                  "kind": "string",
                  "value": "y"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$.a",
            "code": "materialize.inexact-conversion"
          },
          {
            "path": "$.b",
            "code": "materialize.inexact-conversion"
          }
        ]
      },
      "comment": "Materialization MUST collect every problem it finds, not stop at the first, mirroring validate's own collect-all requirement (Sec3.6)."
    },
    {
      "name": "materialize/any/subtree-passes-through-untouched",
      "spec": "docs/07-codecs-and-deserialization.md#72-materialization-rules",
      "operation": "materialize",
      "purpose": "edge-case",
      "input": {
        "schema": "record R {\n    \"data\": any,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "data",
              {
                "edges": [
                  [
                    "x",
                    {
                      "scalar": {
                        "kind": "string",
                        "value": "2024-01-01"
                      }
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "data",
              {
                "edges": [
                  [
                    "x",
                    {
                      "scalar": {
                        "kind": "string",
                        "value": "2024-01-01"
                      }
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "comment": "At an any-typed field, materialization stops: the subtree passes through untouched and no leaf beneath it is upgraded, even one that would otherwise value-exactly upgrade (the string here looks like a date but is left as a string)."
    },
    {
      "name": "materialize/shape/unexpected-field-is-kept-not-dropped",
      "spec": "docs/03-schema-model.md#361-validatedocument-schema-pseudocode",
      "operation": "materialize",
      "purpose": "edge-case",
      "input": {
        "schema": "record R {\n    \"n\": integer,\n}\nroot R\n",
        "document": {
          "edges": [
            [
              "n",
              {
                "scalar": {
                  "kind": "integer",
                  "value": 1
                }
              }
            ],
            [
              "extra",
              {
                "scalar": {
                  "kind": "string",
                  "value": "x"
                }
              }
            ]
          ]
        }
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$.extra",
            "code": "validate.unexpected-field"
          }
        ]
      },
      "comment": "materialize_record appends an unexpected field's (label, child) unchanged to its output rather than dropping it, per Sec7.2.1's pseudocode -- but the call still fails overall since an unexpected field is itself a diagnostic. Shape and cardinality problems during materialization use the validate.* codes, not a separate materialize-specific set (Sec8.3.5)."
    }
  ]
