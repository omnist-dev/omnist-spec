{
  "vectors": [
    {
      "name": "document-model/number-range/json-overflowing-literal-reads-as-positive-infinity",
      "spec": "docs/02-document-model.md#221-scalar-kinds",
      "operation": "parse",
      "purpose": "edge-case",
      "input": {
        "format": "json",
        "text": "{\"a\": 1e999}"
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "number",
                  "value": "Infinity"
                }
              }
            ]
          ]
        }
      },
      "comment": "D-29: `1e999` is too large for binary64 and reads as +Infinity (encoded `\"Infinity\"`, E-33), not as an error."
    },
    {
      "name": "document-model/number-range/json-negative-overflowing-literal-reads-as-negative-infinity",
      "spec": "docs/02-document-model.md#221-scalar-kinds",
      "operation": "parse",
      "purpose": "edge-case",
      "input": {
        "format": "json",
        "text": "{\"a\": -1e999}"
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "number",
                  "value": "-Infinity"
                }
              }
            ]
          ]
        }
      },
      "comment": "D-29: `-1e999` reads as -Infinity."
    },
    {
      "name": "document-model/number-range/json-underflowing-literal-reads-as-zero",
      "spec": "docs/02-document-model.md#221-scalar-kinds",
      "operation": "parse",
      "purpose": "edge-case",
      "input": {
        "format": "json",
        "text": "{\"a\": 1e-999}"
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "a",
              {
                "scalar": {
                  "kind": "number",
                  "value": 0.0
                }
              }
            ]
          ]
        }
      },
      "comment": "D-29: a literal below the smallest subnormal reads as 0.0, the other end of the same IEEE 754 conversion."
    },
    {
      "name": "document-model/number-range/json-overflow-in-a-nested-and-repeated-label",
      "spec": "docs/02-document-model.md#221-scalar-kinds",
      "operation": "parse",
      "purpose": "edge-case",
      "input": {
        "format": "json",
        "text": "{\"o\": {\"a\": [1e400, 2]}}"
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "o",
              {
                "edges": [
                  [
                    "a",
                    {
                      "scalar": {
                        "kind": "number",
                        "value": "Infinity"
                      }
                    }
                  ],
                  [
                    "a",
                    {
                      "scalar": {
                        "kind": "integer",
                        "value": 2
                      }
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "comment": "D-29 at depth and inside an array: the overflowing element is +Infinity, its integer sibling is untouched."
    },
    {
