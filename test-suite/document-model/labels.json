                }
              }
            ],
            [
              "cafe\u0301",
              {
                "scalar": {
                  "kind": "integer",
                  "value": 2
                }
              }
            ]
          ]
        }
      },
      "comment": "D-16 through JSON. The two keys are different byte sequences, so they are not a duplicate-key collision (which would collapse to one edge)."
    },
