{
  "vectors": [
    {
      "name": "document-model/labels/oml-nfc-and-nfd-labels-are-distinct",
      "spec": "docs/02-document-model.md#25-encoding",
      "operation": "parse",
      "purpose": "edge-case",
      "input": {
        "format": "oml",
        "text": "\"caf\u00e9\": 1\n\"cafe\u0301\": 2\n"
      },
      "expect": {
        "ok": true,
        "document": {
          "edges": [
            [
              "caf\u00e9",
              {
                "scalar": {
                  "kind": "integer",
                  "value": 1
                }
              }
            ],
            [
              "cafe\u0301",
              {
                "scalar": {
                  "kind": "integer",
                  "value": 2
                }
              }
            ]
          ]
        }
      },
      "comment": "D-16: `caf\\u00e9` (precomposed, U+00E9) and `cafe\\u0301` (e plus combining acute) are two distinct labels, so the node has two edges, in source order. An implementation that normalizes labels to NFC or NFD on read would collapse them or reorder them. Labels are quoted because OML identifiers are ASCII."
    },
