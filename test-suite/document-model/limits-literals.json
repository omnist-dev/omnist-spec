{
  "vectors": [
    {
      "name": "document-model/limits-literals/toml-hex-literal-of-a-four-digit-value-is-refused",
      "spec": "docs/02-document-model.md#24-safety-limits",
      "operation": "parse",
      "purpose": "error-case",
      "input": {
        "format": "toml",
        "text": "a = 0xFFF\n",
        "declared_max_int_digits": 3
      },
      "expect": {
        "ok": false,
        "diagnostics": [
          {
            "path": "$.a",
            "code": "document.limit.int-digits"
          }
        ]
      },
      "comment": "D-28 at a declared limit of 3: `0xFFF` is three hex digits but the value 4095 has four decimal digits, so it is refused at the literal's Document path, `$.a`. A reader that counts the literal's own digits accepts it."
    },
    {
      "name": "document-model/limits-literals/toml-hex-literal-of-a-three-digit-value-is-accepted",
