; OSD (Omnist Schema Definition) -- ABNF per RFC 5234.
; Normative companion: docs/05-osd-grammar.md
;
; Context conditions ABNF cannot express (all normative, see chapter 5):
;   (S1) Exactly one root-def MUST be present.
;   (S2) A record-def's name MUST NOT be a scalar-name or "any".
;   (S3) Record names MUST be unique; field labels MUST be unique per record.
;   (S4) A cardinality bound MUST be a whole number; the parser rejects a
;        bound containing "."; Field construction rejects a negative min or
;        max < min.
;   (S5) "[" "]" with neither digits nor comma is an error ("empty
;        cardinality"). The `cardinality` rule below already excludes it.

; ---------------------------------------------------------------- top level
; Whitespace and comments are discarded by the tokenizer and may appear
; between any two tokens. This file spells them out so the grammar can be run
; as written: `skip` (zero or more) stands between tokens, `skip1` (one or
; more) where two name-like tokens would otherwise fuse -- after `record` and
; `root`. The only context condition this adds is maximal munch: `recordR`
; and `rootR` are single names, never a keyword plus a name, and a `root`
; name is never followed directly by the keyword `record` or `root` (the
; tokenizer reads the longest name). ABNF cannot express longest-match.
;
; The RFC 5234 core rules ALPHA, DIGIT and DQUOTE are used below and
; deliberately NOT redefined; an ABNF library that predefines them rejects a
; file that restates them.

schema        = [BOM] skip *( ( record-def / root-def ) skip )
                ; declarations may interleave in any order; `root` need not
                ; come last, though canonical output places it last.
                ; BOM: a leading U+FEFF is consumed and contributes
                ; nothing to the Schema (spec 2.5). Permitted only at
                ; offset zero -- see the note on BOM below.

BOM           = %xFEFF
                ; The offset-zero constraint is NOT expressible in this
                ; grammar. These rules are token-level: per the preamble
                ; above, whitespace and comments are discarded by the
                ; tokenizer and may appear between any two tokens, so
                ; `[BOM]` alone would also admit a U+FEFF preceded by
                ; blank lines or a comment. It is the tokenizer that
                ; enforces the constraint: U+FEFF is recognized as a BOM
                ; only as the very first character of the input, and is
                ; ordinary content everywhere else. OML's grammar has no
                ; such gap -- its `document` rule spells the leading
                ; separator out as `[BOM] [SEP] ...`, so BOM is
                ; positionally first in the grammar itself.

record-def    = %s"record" skip1 name skip "{" skip
                [ field skip *( "," skip field skip ) [ "," skip ] ] "}"
                ; a trailing comma after the last field is legal and is what
                ; canonical output emits.

root-def      = %s"root" skip1 name

field         = string skip [ cardinality skip ] ":" skip type
                ; the label MUST be a quoted `string`. An unquoted `name` in
                ; label position is an error.

; -------------------------------------------------------------- cardinality
; Accepts exactly these five shapes and nothing else:
;   [n]     -> min = max = n
;   [m,n]   -> min = m, max = n
;   [m,]    -> min = m, max = unbounded
;   [,n]    -> min = 0, max = n
;   [,]     -> min = 0, max = unbounded
; Note there is NO mandatory minimum bound before the comma: "[,5]" and
; "[,]" are both accepted by the second alternative.

cardinality   = "[" skip ( int [ skip "," [ skip int ] ] / "," [ skip int ] )
                skip "]"

int           = 1*DIGIT
                ; this production accepts only unsigned digits; a conformant
                ; tokenizer's number token MAY nonetheless include an optional
                ; leading "-" (the reference implementation's does, since the
                ; same token reads negative scalar values elsewhere in the
                ; grammar). Either way "[-1]" MUST surface as the (S4)
                ; invalid-cardinality error, never a syntax error -- whether
                ; the "-" is excluded at the token boundary or accepted into
                ; the token and rejected one step later at field construction
                ; is an implementation choice, not an observable difference.

; -------------------------------------------------------------------- types

type          = scalar-type / any-type / ref-type

scalar-type   = scalar-name [ skip "?" ]
scalar-name   = %s"string" / %s"integer" / %s"number" / %s"boolean"
              / %s"date" / %s"time" / %s"datetime"

any-type      = %s"any"
                ; lowercase only. "any?" is an error: `any` already admits
                ; null, so there is no nullable variant to opt into.
                ; Capitalized "Any" is an ordinary name and parses as
                ; ref-type.

ref-type      = name
                ; any `name` that is not a scalar-name and not "any".
                ; "?" MUST NOT follow a ref-type; use cardinality [0,1] for
                ; an optional field.

; ------------------------------------------------------------------- tokens

name          = ( ALPHA / "_" ) *( ALPHA / DIGIT / "_" )
                ; NOTE: no hyphen, unlike OML's IDENT.

string        = DQUOTE *( "\" %x20-10FFFF / %x20-21 / %x23-5B / %x5D-10FFFF )
                DQUOTE
                ; a backslash consumes the NEXT character verbatim; see
                ; chapter 5 for unescaping, which has no named-escape table.
                ; The escape alternative excludes %x00-1F deliberately:
                ; 5.3.1's control-character ban applies to every raw byte in
                ; the string body, escape context included. This rule
                ; previously read "\" %x00-10FFFF, which admitted an escaped
                ; control character the prose forbids -- so a parser generated
                ; from this grammar and one written from the prose disagreed
                ; on the same bytes.

; ------------------------------------------------ whitespace and comments

ws            = %x20 / %x09 / %x0D / %x0A             ; one whitespace char
comment       = "#" *( %x00-09 / %x0B-10FFFF )        ; to end of line

skip          = *( ws / comment )
skip1         = 1*( ws / comment )
