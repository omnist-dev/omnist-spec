; OML (Omnist Markup Language) -- ABNF per RFC 5234.
; Normative companion: docs/04-oml-grammar.md
;
; Two conformance levels are marked inline:
;   [Core]     -- the canonical writer emits it; every reader MUST accept it.
;   [Extended] -- read-only; readers MUST accept it, writers MUST NOT emit it.
;
; ABNF cannot express the three context conditions this grammar relies on.
; They are normative and are stated in prose in docs/04-oml-grammar.md:
;   (T1) Tokenizer priority order (sec 4.2). DATE is emitted only when not
;        followed by "T" plus a TIME-shaped lookahead; nan/inf/-inf are
;        claimed as NUMBER before IDENT is attempted.
;   (T2) bare-label MUST NOT be the text "null", "true", or "false".
;   (T3) One-token lookahead selects `node-edges` over `scalar` at the start
;        of a document or of a braced value (sec 4.6.1).
;   (T4) DATE/TIME/DATETIME/tz-offset value ranges (sec 4.2.4): ABNF only
;        constrains digit counts below, not calendar/clock validity -- month
;        01-12, day valid for month/year, hour 00-23, minute/second 00-59
;        (no leap seconds) are normative and enforced at parse time.
; Limits (sec 4.7): INTEGER digit count <= 4300; brace nesting depth <= 200.
;
; The RFC 5234 core rules ALPHA, DIGIT, DQUOTE and HEXDIG are used below but
; deliberately NOT redefined: appendix B.1 of RFC 5234 defines them, and an
; ABNF library that predefines the core rules rejects a file that restates
; them. Whitespace: `gap` (any run, possibly empty) stands wherever the
; tokenizer skips or collapses separators; `SEP` is the one place a newline or
; ";" is REQUIRED (between two edges). Horizontal space and comments alone
; never make a SEP (sec 4.2.1, OML-26/27).

; ---------------------------------------------------------------- document

document      = [BOM] gap ( node-edges / scalar ) gap
                ; see (T3) for the disambiguation; node-edges may be empty,
                ; so the empty document is legal.
                ; BOM: a leading U+FEFF is consumed and contributes
                ; nothing to the Document (spec 2.5). It is permitted
                ; only here, at offset zero; anywhere else U+FEFF is
                ; ordinary content.

BOM           = %xFEFF

node-edges    = [ edge *( SEP edge ) ]

edge          = label skip COLON gap value
                ; hspace and comments are allowed before the colon
                ; (`a : 1`), but not a newline or ";": there a SEP token
                ; would stand where the colon is owed.

label         = STRING / bare-label
bare-label    = IDENT                          ; subject to (T2)

value         = scalar
              / LBRACE gap node-edges gap RBRACE
              / array

; ------------------------------------------------------------------ arrays
; Sugar: expanded at parse time into repeated edges at this position.
; Elements are never arrays -- there is nothing to nest into.
; "[]" is NOT accepted: array requires at least one element.

array         = LBRACKET gap array-element gap
                *( COMMA gap array-element gap )
                [ COMMA gap ] RBRACKET

array-element = scalar
              / LBRACE gap node-edges gap RBRACE

; ----------------------------------------------------------------- scalars

scalar        = STRING / DATETIME / DATE / TIME / NUMBER / INTEGER
              / %s"null" / %s"true" / %s"false"
                ; token order here mirrors (T1); a bare IDENT that is none of
                ; null/true/false is NOT a scalar and is an error.

; ------------------------------------------------- whitespace / separators

hspace        = %x20 / %x09                    ; space, tab; intra-line only
newline       = %x0D.0A / %x0A                 ; CRLF or LF
comment       = "#" *( %x00-09 / %x0B-10FFFF ) ; to end of line, NL excluded

skip          = *( hspace / comment )
                ; skipped whitespace: emits no token. Never contains a
                ; newline or ";".

gap           = *( hspace / comment / newline / ";" )
                ; any run, possibly empty, with or without a newline or ";":
                ; the places where a separator is insignificant.

SEP           = skip ( newline / ";" ) gap
                ; a run containing at least one newline or ";" -- the
                ; separator REQUIRED between two edges. A run without one
                ; is skipped whitespace (`skip`), not a SEP.

; -------------------------------------------------------------- punctuation

LBRACE        = "{"
RBRACE        = "}"
LBRACKET      = "["
RBRACKET      = "]"
COLON         = ":"
COMMA         = ","

; ------------------------------------------------------------- identifiers

IDENT         = ( ALPHA / "_" ) *( ALPHA / DIGIT / "_" / "-" )
                ; ALPHA, DIGIT, HEXDIG, DQUOTE: RFC 5234 core rules.

; ------------------------------------------------- numeric / temporal atoms

INTEGER       = [ "-" ] int-part                ; <= 4300 digits, sign excluded
int-part      = "0" / ( %x31-39 *DIGIT )       ; no leading zero (sec 4.2.3)

NUMBER        = decimal-num / exponent-num / reserved-number
decimal-num   = [ "-" ] int-part "." 1*DIGIT [ exponent ]
exponent-num  = [ "-" ] int-part exponent
exponent      = ( "e" / "E" ) [ "+" / "-" ] 1*DIGIT
reserved-number = %s"nan" / %s"inf" / "-" %s"inf"
                ; claimed before IDENT by (T1); never a bare label.

DATE          = 4DIGIT "-" 2DIGIT "-" 2DIGIT   ; subject to (T1) lookahead
                                                ; and (T4) calendar validity
TIME          = 2DIGIT ":" 2DIGIT [ ":" 2DIGIT [ "." 1*6DIGIT ] ] [ tz-offset ]
                                                ; subject to (T4) clock validity
DATETIME      = DATE %s"T" 2DIGIT ":" 2DIGIT
                [ ":" 2DIGIT [ "." 1*6DIGIT ] ] [ tz-offset ]
tz-offset     = ( "+" / "-" ) 2DIGIT ":" 2DIGIT
                                                ; subject to (T4), same ranges
                                                ; as TIME's hour/minute

; ------------------------------------------------------------------ strings

STRING        = dquote-string                  ; [Core]
              / raw-string                     ; [Extended]
              / multiline-string               ; [Extended]

dquote-string = DQUOTE *( unescaped / escape ) DQUOTE
unescaped     = %x20-21 / %x23-5B / %x5D-10FFFF
                ; any char >= U+0020 except '"' and '\'; control characters
                ; below U+0020 are an error.
escape        = "\" ( %x22 / "\" / "/" / %s"b" / %s"f" / %s"n" / %s"r"
                      / %s"t" / %s"u" 4HEXDIG [ "\" %s"u" 4HEXDIG ] )
                ; the escape letters are case-sensitive (%s): `\N` and `\U0041`
                ; are errors (OML-14). Plain ABNF literals would match both
                ; cases. Deliberately case-insensitive: `exponent`'s e/E and
                ; HEXDIG's a-f, which the prose accepts in either case.
                ; a \uXXXX in D800-DBFF MUST be followed by a second \uXXXX
                ; in DC00-DFFF; an unpaired surrogate escape is an error.
                ; That range condition is not expressible in ABNF.

raw-string    = "'" *( %x00-26 / %x28-10FFFF ) "'"     ; [Extended]
                ; no escape processing at all.

multiline-string = 3DQUOTE [ newline ]                 ; [Extended]
                   *( ml-nonquote / DQUOTE ml-nonquote
                      / DQUOTE DQUOTE ml-nonquote )
                   3DQUOTE
                ; closes at the FIRST run of 3 or more '"'; only the first 3
                ; are consumed. Runs of 1-2 quotes are literal content, which
                ; is why every body alternative ends in a non-quote: no body
                ; contains three consecutive '"'. (The rule `not-3-dquote` of
                ; earlier drafts accepted `"""a""" b """` as one string; this
                ; shape does not.)
ml-nonquote   = %x09 / %x0A / %x20-21 / %x23-10FFFF
                ; tab, LF, or >= U+0020 other than '"'; other control
                ; characters are an error.
